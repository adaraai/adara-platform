# Client-side variables must be prefixed with VITE_ to be bundled.
# Add production values in the Vercel project (Settings → Environment Variables).

# VITE_API_BASE=https://api.adara.ai

# Contact form delivery (free key from https://web3forms.com, tied to the receiving inbox).
VITE_WEB3FORMS_KEY=

# Server-only (no VITE_ prefix): confirmation email to waitlist signups via https://resend.com.
RESEND_API_KEY=
# Defaults to Resend's test sender, which only delivers to your Resend account email until a domain is verified.
# WAITLIST_FROM_EMAIL=Adara AI Lab <hello@adaraai.xyz>
